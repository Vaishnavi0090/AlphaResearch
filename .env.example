# Optional. Without it the agent layer uses StubLLM, a deterministic
# template narrator. Everything else works unchanged.
ANTHROPIC_API_KEY=

# Optional LangSmith tracing. Never required.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finrisk-ai

# Optional FRED key for real macro data.
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact details.
SEC_USER_AGENT=finrisk-ai research (your.email@example.com)
